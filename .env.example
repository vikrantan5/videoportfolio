# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key - safe for the browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key - SERVER ONLY, never expose to the browser. Used by admin server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Contact form email notifications (optional, https://resend.com/api-keys) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where inquiry notifications are delivered
NOTIFY_EMAIL=you@example.com
# Sender (must be a verified Resend domain, or use onboarding@resend.dev for testing)
NOTIFY_FROM=Portfolio <onboarding@resend.dev>

# --- Site ---
# Public origin, used for sitemap/robots/OG canonical URLs (e.g. https://factdefiner.com)
NEXT_PUBLIC_BASE_URL=https://your-domain.com
